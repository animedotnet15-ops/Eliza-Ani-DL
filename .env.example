# ── Telegram credentials (my.telegram.org + BotFather) ─────────────────────
API_ID=
API_HASH=
BOT_TOKEN=

# ── Bot identity ─────────────────────────────────────────────────────────
BOT_NAME=Eliza

# ── Owner / extra bot admins ────────────────────────────────────────────
OWNER_ID=
ADMINS=

# ── MongoDB Atlas ────────────────────────────────────────────────────────
DATABASE_URI=
DATABASE_NAME=eliza

# ── Source channels to auto-index (comma-separated numeric ids) ────────
# Can also be added later with /addchannel
SOURCE_CHANNELS=

# ── Log channel (bot must be admin there) ───────────────────────────────
LOG_CHANNEL=

# ── Force subscribe (comma-separated @usernames; editable later too) ───
FORCE_SUB_CHANNELS=

# ── Link shortener (editable later via admin panel too) ─────────────────
SHORTENER_API=
SHORTENER_DOMAIN=
VERIFY_MIN_MINUTES=2
VERIFY_MAX_MINUTES=5
VERIFY_VALIDITY_HOURS=6

# ── Optional: AI-powered "similar anime" suggestions ────────────────────
GEMINI_API_KEY=

# ── Branding links ───────────────────────────────────────────────────────
SUPPORT_CHAT=
UPDATES_CHANNEL=

# ── Default language before a user picks their own ──────────────────────
DEFAULT_LANGUAGE=en

# ── Web server (Render/Railway bind this automatically via PORT) ───────
PORT=8080
